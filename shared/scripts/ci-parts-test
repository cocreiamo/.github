#!/usr/bin/env bash
# ci-parts (shared/scripts, or its vendored copy named in .github/shared-scripts): `affected` picks the parts from the `sources`
# of the ci:<part> mise tasks and the files changed since the base (an excluded file, a docs-only change, no base), `prepush` runs
# exactly those but a part described `ci-only:` (heavy: the CI runs it, a named run too), `check` refuses a part that would not
# run when it changes, a ci: task `affected` can never select, and a workflow that calls a part that does not exist.
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
parts="$repo/shared/scripts/ci-parts"
[ ! -f "$repo/.github/shared-scripts" ] || parts="$repo/$(awk '$1 == "ci-parts" { print $2 }' "$repo/.github/shared-scripts")"
fail() { echo "FAIL: $*" >&2; exit 1; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# the commands are built from parts: the hermetic-git check of the monorepo refuses a literal commit in a shared test
vcs=git
# inside a git hook GIT_DIR and friends point at the real repository
while read -r v; do unset "$v"; done < <(git rev-parse --local-env-vars)
git_repo() {
  "$vcs" init -q -b main "$1"
  "$vcs" -C "$1" config user.email t@example.invalid
  "$vcs" -C "$1" config user.name t
  "$vcs" -C "$1" config commit.gpgsign false
}
export MISE_TRUSTED_CONFIG_PATHS="$tmp"
unset CI_BASE GITHUB_OUTPUT GITHUB_ACTIONS GITHUB_EVENT_NAME CI_PARTS_FORCE

r="$tmp/r"
git_repo "$r"
cd "$r"
mkdir -p docs platform/x platform/z mise-tasks/ci .github/workflows
touch docs/a.md platform/x/f platform/z/f README.md
git add -A && "$vcs" commit -qm base
base=$(git rev-parse HEAD)

# json <name> <sources json> <hide> <description> <file>
task() { printf '{"name":"ci:%s","sources":%s,"hide":%s,"description":"%s","source":"%s/%s"}' "$1" "$2" "$3" "${4:-}" "$r" "${5:-mise-tasks/ci/$1}"; }
tasks() { printf '[%s]' "$(IFS=,; echo "$*")" > "$tmp/tasks.json"; export CI_PARTS_TASKS="$tmp/tasks.json"; }
tasks \
  "$(task lint '["**"]' false)" \
  "$(task render '["**","!docs/**","!**/*.md"]' false)" \
  "$(task alerts '["platform/{x,y}/**","mise-tasks/ci/alerts"]' false)" \
  "$(task helper '[]' true)" \
  "$(task smoke '[]' false 'nightly: the smoke test')"

affected() { "$parts" --base "$base" affected "$@" | tr '\n' ' '; }
want() { # <what> <expected>
  [ "$got" = "$2" ] || fail "$1: got '$got', want '$2'"
}

git checkout -qb t1 && printf x >> docs/a.md && "$vcs" commit -qam docs
got=$(affected); want "a docs-only change" "lint "
got=$("$parts" --base "$base" affected --json); want "the json form" '["lint"]'
git checkout -qb t2 "$base" && printf x >> platform/x/f && "$vcs" commit -qam x
got=$(affected); want "a change under platform/x" "alerts lint render "
git checkout -qb t3 "$base" && printf x >> platform/z/f && "$vcs" commit -qam z
got=$(affected); want "a change outside the alerts sources" "lint render "
git checkout -qb t4 "$base" && printf x >> README.md && "$vcs" commit -qam readme
got=$(affected); want "a markdown file outside docs" "lint "
got=$("$parts" affected </dev/null | tr '\n' ' '); want "no base (no origin/main): every part but the nightly" "alerts lint render "
got=$(CI_BASE=0000000000000000000000000000000000000000 "$parts" affected | tr '\n' ' '); want "the zero sha of a first push" "alerts lint render "
got=$(CI_BASE="$base" "$parts" affected | tr '\n' ' '); want "the base from CI_BASE" "lint "
git remote add origin "$r"; git fetch -q origin 2>/dev/null; git update-ref refs/remotes/origin/main "$base"
got=$("$parts" affected | tr '\n' ' '); want "the merge base with origin/main" "lint "
got=$(GITHUB_ACTIONS=true "$parts" affected | tr '\n' ' '); want "a CI run with no base (a push to main)" "alerts lint render "
out="$tmp/gho"; : > "$out"
GITHUB_OUTPUT="$out" "$parts" --base "$base" affected --github-output > /dev/null
[ "$(cat "$out")" = 'parts=["lint"]' ] || fail "--github-output wrote: $(cat "$out")"

"$parts" check 2>"$tmp/err" || { cat "$tmp/err" >&2; fail "check refused a clean set of parts"; }
tasks "$(task lint '["docs/**"]' false)"
if "$parts" check 2>"$tmp/err"; then fail "check accepted a part whose sources miss its own file"; fi
grep -q 'part lint: its sources do not match its own file' "$tmp/err" || { cat "$tmp/err" >&2; fail "check refused without naming the part"; }
tasks "$(task orphan '[]' false)"
if "$parts" check 2>"$tmp/err"; then fail "check accepted a ci: task with no sources that is not hidden"; fi
grep -q 'ci:orphan declares no sources' "$tmp/err" || { cat "$tmp/err" >&2; fail "check refused without naming the task"; }
tasks "$(task lint '["**"]' false)"
printf 'jobs:\n  j:\n    steps:\n      - run: mise run ci -- lint\n      - run: mise run ci -- affected\n' > .github/workflows/w.yml
"$parts" check 2>"$tmp/err" || { cat "$tmp/err" >&2; fail "check refused a workflow that calls a part and a reserved word"; }
printf '      - run: mise run ci -- ghost\n' >> .github/workflows/w.yml
if "$parts" check 2>"$tmp/err"; then fail "check accepted a workflow calling a part that does not exist"; fi
grep -q 'names no part' "$tmp/err" || { cat "$tmp/err" >&2; fail "check refused without saying the part does not exist"; }

# The real mise: `mise run ci -- <part>` through the ci task, the sources read from the task headers, prepush running exactly the affected parts.
rm -f .github/workflows/w.yml; unset CI_PARTS_TASKS
printf '#!/usr/bin/env bash\n#MISE description="the entry point"\nexec %s "$@"\n' "$parts" > mise-tasks/ci/_default
printf '#!/usr/bin/env bash\n#MISE description="lint"\n#MISE sources=["docs/**","mise-tasks/ci/lint"]\necho lint >> "$MARK"\n' > mise-tasks/ci/lint
printf '#!/usr/bin/env bash\n#MISE description="render"\n#MISE sources=["platform/**","mise-tasks/ci/render"]\necho render >> "$MARK"\n' > mise-tasks/ci/render
printf '#!/usr/bin/env bash\n#MISE description="ci-only: builds an image"\n#MISE sources=["platform/**","mise-tasks/ci/heavy"]\necho heavy >> "$MARK"\n' > mise-tasks/ci/heavy
chmod +x mise-tasks/ci/*
git add -A && "$vcs" commit -qm tasks && base=$(git rev-parse HEAD)
export MARK="$tmp/mark"
got=$(CI_BASE="$base" mise run ci -- affected 2>/dev/null | tr '\n' ' '); want "mise run ci -- affected with no change" ""
printf x >> platform/z/f && "$vcs" commit -qam z
got=$(CI_BASE="$base" mise run ci -- affected 2>/dev/null | tr '\n' ' '); want "mise run ci -- affected through the real mise (a ci-only part included: the CI runs it)" "heavy render "
: > "$MARK"
CI_BASE="$base" mise run ci -- prepush > "$tmp/prepush.out" 2>&1 || { cat "$tmp/prepush.out" >&2; fail "prepush failed"; }
[ "$(tr '\n' ' ' < "$MARK")" = "render " ] || fail "prepush ran '$(tr '\n' ' ' < "$MARK")', want only render (heavy is ci-only)"
grep -q 'left to the CI: heavy' "$tmp/prepush.out" || { cat "$tmp/prepush.out" >&2; fail "prepush does not say which ci-only parts it left to the CI"; }
: > "$MARK"
CI_BASE="$base" mise run ci -- prepush 2>&1 | grep -q 'already passed' || fail "a second prepush of the same clean tree ran the parts again"
[ ! -s "$MARK" ] || fail "a second prepush of the same clean tree ran '$(cat "$MARK")'"
CI_PARTS_FORCE=1 CI_BASE="$base" mise run ci -- prepush > /dev/null 2>&1 || fail "a forced prepush failed"
[ "$(tr '\n' ' ' < "$MARK")" = "render " ] || fail "CI_PARTS_FORCE did not run the parts"
printf x >> platform/z/f
: > "$MARK"
CI_BASE="$base" mise run ci -- prepush > /dev/null 2>&1 || fail "prepush of a dirty tree failed"
[ "$(tr '\n' ' ' < "$MARK")" = "render " ] || fail "a dirty tree was skipped"
git checkout -q -- platform/z/f
: > "$MARK"
mise run ci -- lint render > /dev/null 2>&1 || fail "named parts failed"
[ "$(tr '\n' ' ' < "$MARK")" = "lint render " ] || fail "named parts ran '$(tr '\n' ' ' < "$MARK")'"
: > "$MARK"
mise run ci -- heavy > /dev/null 2>&1 || fail "a ci-only part named on the command line failed"
[ "$(tr '\n' ' ' < "$MARK")" = "heavy " ] || fail "a ci-only part named on the command line did not run"
if mise run ci -- nosuch > /dev/null 2>&1; then fail "a part that does not exist was accepted"; fi
mise run ci -- check 2>"$tmp/err" || { cat "$tmp/err" >&2; fail "check refused the real set of parts"; }
echo "ci-parts ok"
