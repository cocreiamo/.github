#!/usr/bin/env bash
# hooks-check (shared/scripts, or its vendored copy next to testlib.sh) on throwaway repositories: one hook manager everywhere, the
# pre-commit framework. Refused: no .pre-commit-config.yaml, a config without one of the shared hooks (conflict-markers,
# commit-identity at pre-commit, ci-prepush at pre-push), a core.hooksPath that bypasses the framework, a declared hook type with no
# installed hook or a hook git runs that the framework did not write. A repository whose installed hooks equal the declared set passes.
# shellcheck disable=SC1091,SC2154 # the library is a sibling file; $tmp comes from it
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/testlib.sh"
check="$here/hooks-check"
tmpdir
git_env_clear
G=git
good='default_install_hook_types: [pre-commit, pre-push]
repos:
  - repo: local
    hooks:
      - id: conflict-markers
        name: conflict markers
        entry: tools/conflict-markers
        language: system
        pass_filenames: false
      - id: commit-identity
        name: commit identity
        entry: tools/commit-identity
        language: system
        pass_filenames: false
        always_run: true
      - id: ci-prepush
        name: the CI parts this push touches
        entry: mise run ci -- prepush
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]'
installed() { printf '#!/usr/bin/env bash\n# File generated by pre-commit: https://pre-commit.com\n# ID: 138fd403232d2ddd5efb44317e38bf03\n' > "$tmp/r/.git/hooks/$1"; chmod +x "$tmp/r/.git/hooks/$1"; }
fresh() { rm -rf "$tmp/r"; git_repo "$tmp/r"; printf '%s\n' "${1-$good}" > "$tmp/r/.pre-commit-config.yaml"; installed pre-commit; installed pre-push; }
run() { (cd "$tmp/r" && "$check") > "$tmp/out" 2>&1; }
ok() { run || { cat "$tmp/out" >&2; fail "refused $1"; }; }
bad() { if run; then fail "accepted $1"; fi; grep -qF -- "$2" "$tmp/out" || { cat "$tmp/out" >&2; fail "refused $1 without saying '$2'"; }; }

fresh; ok "the declared hooks installed by the framework"
fresh; rm "$tmp/r/.pre-commit-config.yaml"; bad "a repository with no config" ".pre-commit-config.yaml"
fresh "${good//conflict-markers/other}"; bad "a config without conflict-markers" "conflict-markers"
fresh "${good//        stages: \[pre-push\]/}"; bad "ci-prepush outside the pre-push stage" "ci-prepush"
fresh; "$G" -C "$tmp/r" config core.hooksPath hooks; bad "a core.hooksPath" "core.hooksPath"
grep -qF "main checkout ($tmp/r)" "$tmp/out" && grep -qF "never inside a worktree" "$tmp/out" \
  || { cat "$tmp/out" >&2; fail "the core.hooksPath advice does not name the one-time cutover on the main checkout"; }
"$G" -C "$tmp/r" add .pre-commit-config.yaml; "$G" -C "$tmp/r" commit -q -m "chore: root"
"$G" -C "$tmp/r" worktree add -q -b topic "$tmp/wt"
(cd "$tmp/wt" && "$check") > "$tmp/out" 2>&1 && fail "accepted a core.hooksPath seen from a worktree"
grep -qF "main checkout ($tmp/r)" "$tmp/out" || { cat "$tmp/out" >&2; fail "the advice from a worktree does not name the main checkout"; }
rm -rf "$tmp/wt"
fresh; rm "$tmp/r/.git/hooks/pre-push"; bad "a declared type not installed" "pre-push"
fresh; printf '#!/bin/sh\nexit 0\n' > "$tmp/r/.git/hooks/commit-msg"; chmod +x "$tmp/r/.git/hooks/commit-msg"; bad "a hook the framework did not write" "commit-msg"
fresh; printf '#!/bin/sh\nexit 0\n' > "$tmp/r/.git/hooks/pre-push"; bad "a declared type overwritten by hand" "pre-push"
fresh; HOOKS_CHECK_CONFIG_ONLY=1 run || { cat "$tmp/out" >&2; fail "the config-only mode refused a good config"; }
fresh; rm "$tmp/r/.git/hooks/pre-push"; HOOKS_CHECK_CONFIG_ONLY=1 run || fail "the config-only mode (the CI, no hooks installed) looked at the installed hooks"
echo "hooks-check: ok"
