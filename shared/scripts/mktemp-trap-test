#!/usr/bin/env bash
# mktemp-trap-check on fixture trees: a shell script that calls mktemp with no EXIT trap that removes what it made is refused (the leaked tmp.* directories
# that filled a workstation disk), as are an EXIT trap that does not remove anything and an allowlist line without a reason; a script with the trap, one that
# only names mktemp in a comment or runs `mktemp -u`, a non-shell file and an allowlisted script pass; the offenders are counted and listed.
# The Python class: tempfile.mkdtemp, mkstemp or NamedTemporaryFile(delete=False) with no removal in a finally block or an atexit handler is refused.
# shellcheck disable=SC2016 # the fixture bodies are single-quoted on purpose: they are script text, not expanded here
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
check="$repo/shared/scripts/mktemp-trap-check"
[ ! -f "$repo/.github/shared-scripts" ] || check="$repo/$(awk '$1 == "mktemp-trap-check" { print $2 }' "$repo/.github/shared-scripts")"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }
fixture() { rm -rf "$tmp/r"; mkdir -p "$tmp/r/tools" "$tmp/r/.github"; }
put() { printf '#!/usr/bin/env bash\n%s\n' "$2" > "$tmp/r/$1"; }
refused() { # <what> <text in the refusal>
  if "$check" "$tmp/r" > "$tmp/out" 2>&1; then cat "$tmp/out" >&2; fail "accepted $1"; fi
  grep -qF "$2" "$tmp/out" || { cat "$tmp/out" >&2; fail "refused $1 without saying '$2'"; }
}
accepted() { "$check" "$tmp/r" > "$tmp/out" 2>&1 || { cat "$tmp/out" >&2; fail "refused $1: $(cat "$tmp/out")"; }; }

fixture
put tools/leaky 'tmp="$(mktemp -d)"
echo work > "$tmp/x"'
refused "a mktemp with no trap" "tools/leaky"
grep -qF "1 script" "$tmp/out" || fail "the offenders are not counted: $(cat "$tmp/out")"

fixture
put tools/printing-trap 'tmp="$(mktemp -d)"
trap '"'"'echo bye'"'"' EXIT'
refused "an EXIT trap that removes nothing" "tools/printing-trap"

fixture
put tools/signal-only 'tmp="$(mktemp -d)"
trap '"'"'rm -rf "$tmp"'"'"' INT'
refused "a trap on INT only" "tools/signal-only"

fixture
put tools/clean 'tmp="$(mktemp -d)"
trap '"'"'rm -rf "$tmp"'"'"' EXIT'
put tools/clean2 'f="$(mktemp)"
trap "rm -f $f" EXIT'
put tools/comment '# uses mktemp -d in the docs only'
put tools/dry 'name="$(mktemp -u)"'
printf 'mktemp -d\n' > "$tmp/r/notes.md"
accepted "the clean scripts"

fixture
put tools/leaky 'tmp="$(mktemp -d)"'
printf 'tools/leaky\n' > "$tmp/r/.github/mktemp-trap-allowlist"
refused "an allowlist line with no reason" "reason"
printf 'tools/leaky the caller removes the directory it passes in\n' > "$tmp/r/.github/mktemp-trap-allowlist"
accepted "an allowlisted script"

fixture
cp "$check" "$tmp/r/tools/mktemp-trap-check"
accepted "the check itself (its own messages name the command)"

fixture
mkdir -p "$tmp/r/vendor/up"
put vendor/up/configure 'tmp="$(mktemp -d)"'
put tools/leaky 'tmp="$(mktemp -d)"'
printf 'vendor/up/ vendored upstream\n' > "$tmp/r/.github/mktemp-trap-allowlist"
refused "a leak outside an allowlisted directory" "tools/leaky"
grep -qF "vendor/up" "$tmp/out" && fail "a directory allowlist line did not exclude vendor/up: $(cat "$tmp/out")"
rm "$tmp/r/tools/leaky"
accepted "an allowlisted directory"

fixture
mkdir -p "$tmp/r/py"
printf 'import tempfile\n\n\ndef work():\n    d = tempfile.mkdtemp()\n    return d\n' > "$tmp/r/py/leaky.py"
printf '#!/usr/bin/env python3\nfrom tempfile import mkstemp\nfd, path = mkstemp()\n' > "$tmp/r/py/leaky-script"
printf 'import tempfile\n\nf = tempfile.NamedTemporaryFile(delete=False)\n' > "$tmp/r/py/keep.py"
refused "a Python mkdtemp with no cleanup" "py/leaky.py"
grep -qF "py/leaky-script" "$tmp/out" || fail "a python-shebang mkstemp with no cleanup was accepted: $(cat "$tmp/out")"
grep -qF "py/keep.py" "$tmp/out" || fail "a NamedTemporaryFile(delete=False) with no cleanup was accepted: $(cat "$tmp/out")"
grep -qF "3 script" "$tmp/out" || fail "the Python offenders are not counted: $(cat "$tmp/out")"

fixture
mkdir -p "$tmp/r/py"
printf 'import shutil\nimport tempfile\n\n\ndef work():\n    d = tempfile.mkdtemp()\n    print(d)\n    shutil.rmtree(d)\n' > "$tmp/r/py/no-finally.py"
refused "a Python mkdtemp removed only on the happy path" "py/no-finally.py"

fixture
mkdir -p "$tmp/r/py"
printf 'import shutil\nimport tempfile\n\n\ndef work():\n    d = tempfile.mkdtemp()\n    try:\n        print(d)\n    finally:\n        shutil.rmtree(d, ignore_errors=True)\n' > "$tmp/r/py/finally.py"
printf 'import atexit\nimport shutil\nimport tempfile\n\nD = tempfile.mkdtemp()\natexit.register(shutil.rmtree, D, True)\n' > "$tmp/r/py/atexit.py"
printf 'import os\nimport tempfile\n\nfd, p = tempfile.mkstemp()\ntry:\n    os.write(fd, b"x")\nfinally:\n    os.unlink(p)\n' > "$tmp/r/py/unlink.py"
printf 'import tempfile\n\nwith tempfile.TemporaryDirectory() as d:\n    print(d)\n# tempfile.mkdtemp() in a comment\n' > "$tmp/r/py/context.py"
printf 'import tempfile\n\nf = tempfile.NamedTemporaryFile()\n' > "$tmp/r/py/auto.py"
printf 'import shutil\nimport tempfile\nimport unittest\n\n\nclass T(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n' > "$tmp/r/py/teardown_test.py"
printf 'import shutil\nimport tempfile\nimport unittest\n\n\nclass T(unittest.TestCase):\n    def test_x(self):\n        d = tempfile.mkdtemp()\n        self.addCleanup(shutil.rmtree, d)\n' > "$tmp/r/py/addcleanup_test.py"
mkdir -p "$tmp/r/tests/x/bad"
printf 'import tempfile\n\ntempfile.mkdtemp()\n' > "$tmp/r/tests/x/bad/leak.py"
accepted "the Python files that clean up, and a bad fixture"

fixture
mkdir -p "$tmp/r/py"
printf 'import tempfile\nimport unittest\n\n\nclass T(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n\n    def tearDown(self):\n        print(self.d)\n' > "$tmp/r/py/notorn_test.py"
refused "a setUp mkdtemp whose tearDown removes nothing" "py/notorn_test.py"

echo "mktemp-trap-check: ok"
