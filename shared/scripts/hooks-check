#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""hooks-check: one hook manager in every repository, the pre-commit framework, with the shared hooks.

Run at the root of a repository. Refused:
  - no .pre-commit-config.yaml;
  - a config without the shared hooks: `conflict-markers` and `commit-identity` at pre-commit, `ci-prepush` at pre-push (the CI
    parts the push touches), and a default_install_hook_types that does not name pre-commit and pre-push;
  - core.hooksPath set: git then runs another directory and the framework's hooks never fire;
  - a declared hook type with no hook installed by the framework, or a hook in .git/hooks that the framework did not write
    (the installed hooks equal the declared set; `pre-commit install` writes them).
HOOKS_CHECK_CONFIG_ONLY=1 checks the config alone (the CI, where nothing is installed).
"""

import os
import pathlib
import subprocess
import sys

import yaml

SHARED = {
    "conflict-markers": "pre-commit",
    "commit-identity": "pre-commit",
    "ci-prepush": "pre-push",
}
MARKER = "File generated by pre-commit"
GIT_HOOKS = {
    "applypatch-msg", "commit-msg", "post-applypatch", "post-checkout", "post-commit", "post-merge", "post-rewrite",
    "pre-applypatch", "pre-auto-gc", "pre-commit", "pre-merge-commit", "pre-push", "pre-rebase", "prepare-commit-msg",
}  # fmt: skip


def git(*args):
    r = subprocess.run(["git", *args], check=False, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def config_problems(config):
    problems = []
    declared = config.get("default_install_hook_types") or ["pre-commit"]
    for kind in ("pre-commit", "pre-push"):
        if kind not in declared:
            problems.append(f"default_install_hook_types does not name {kind}")
    hooks = {}
    for repo in config.get("repos") or []:
        for hook in repo.get("hooks") or []:
            hooks[hook.get("id")] = hook
    for hook_id, stage in SHARED.items():
        hook = hooks.get(hook_id)
        if hook is None:
            problems.append(f"the shared hook {hook_id} is missing")
            continue
        stages = hook.get("stages") or config.get("default_stages") or ["pre-commit"]
        if stage not in stages:
            problems.append(
                f"the shared hook {hook_id} must run at {stage} (stages: {stages})"
            )
    return problems, declared


def main():
    path = pathlib.Path(".pre-commit-config.yaml")
    if not path.is_file():
        print(
            "hooks-check: no .pre-commit-config.yaml: every repository runs the pre-commit framework",
            file=sys.stderr,
        )
        return 1
    problems, declared = config_problems(yaml.safe_load(path.read_text()) or {})
    if os.environ.get("HOOKS_CHECK_CONFIG_ONLY") != "1":
        if git("config", "--get", "core.hooksPath"):
            problems.append(
                "core.hooksPath is set: git runs that directory and the framework's hooks never fire"
                " (git config --unset core.hooksPath)"
            )
        hooks_dir = pathlib.Path(
            git("rev-parse", "--git-path", "hooks") or ".git/hooks"
        )
        installed = {}
        if hooks_dir.is_dir():
            for f in hooks_dir.iterdir():
                if f.name in GIT_HOOKS and f.is_file() and os.access(f, os.X_OK):
                    installed[f.name] = MARKER in f.read_text(errors="replace")
        for kind in declared:
            if not installed.get(kind):
                problems.append(
                    f"the declared hook type {kind} is not installed by the framework (pre-commit install)"
                )
        for kind, ours in sorted(installed.items()):
            if kind not in declared or not ours:
                problems.append(
                    f".git/hooks/{kind} is not a hook the framework installed for a declared type: remove it, or declare it"
                )
    for p in problems:
        print(f"hooks-check: {p}", file=sys.stderr)
    if problems:
        return 1
    print(
        "hooks-check: the pre-commit framework runs the shared hooks"
        + (
            ""
            if os.environ.get("HOOKS_CHECK_CONFIG_ONLY") == "1"
            else ", installed as declared"
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
