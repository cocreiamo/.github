#!/usr/bin/env bash
# workflow-hygiene-check.py (shared/scripts, or its vendored copy named in .github/shared-scripts) on fixture workflows: a job
# with no timeout-minutes, a concurrency group of a push-triggered workflow keyed on the ref alone (queued pushes to main
# cancel each other), a `uses:` pinned to the SHA of an annotated tag object (not a commit), an env value over 100000 bytes (a step
# cannot start once one variable passes the kernel's 131072) and a run script over 60000 bytes (actionlint's shellcheck pass hangs
# past the 64 KiB pipe buffer) are refused; the clean forms pass.
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
check="$repo/shared/scripts/workflow-hygiene-check.py"
[ ! -f "$repo/.github/shared-scripts" ] || check="$repo/$(awk '$1 == "workflow-hygiene-check.py" { print $2 }' "$repo/.github/shared-scripts")"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }
COMMIT=1111111111111111111111111111111111111111
TAG=2222222222222222222222222222222222222222
mkdir -p "$tmp/kinds/acme/tool"
echo commit > "$tmp/kinds/acme/tool/$COMMIT"
echo tag > "$tmp/kinds/acme/tool/$TAG"
export WORKFLOW_HYGIENE_KINDS="$tmp/kinds"
export WORKFLOW_HYGIENE_OFFLINE=1

# fixture <workflow text>
fixture() { rm -rf "$tmp/r"; mkdir -p "$tmp/r/.github/workflows"; printf '%s\n' "$1" > "$tmp/r/.github/workflows/w.yml"; }
refused() { # <what> <text in the refusal>
  if "$check" "$tmp/r" > "$tmp/out" 2>&1; then cat "$tmp/out" >&2; fail "accepted $1"; fi
  grep -qF "$2" "$tmp/out" || { cat "$tmp/out" >&2; fail "refused $1 without saying '$2'"; }
}
accepted() { "$check" "$tmp/r" > "$tmp/out" 2>&1 || { cat "$tmp/out" >&2; fail "refused $1"; }; }

wf() { # <concurrency group> <job extra lines> <step uses>
  printf 'name: x\non:\n  push:\n    branches: [main]\n%s\njobs:\n  j:\n    runs-on: ubuntu-latest\n%s\n    steps:\n      - uses: %s\n' "$1" "$2" "$3"
}
GOOD_GROUP='concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.sha }}'
TIMEOUT='    timeout-minutes: 5'

fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "acme/tool@$COMMIT")"
accepted "a job with a timeout, a sha-keyed group and a commit pin"

fixture "$(wf "$GOOD_GROUP" "" "acme/tool@$COMMIT")"
refused "a job with no timeout-minutes" "job j: no timeout-minutes"

fixture "$(wf 'concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}' "$TIMEOUT" "acme/tool@$COMMIT")"
refused "a push group keyed on the ref alone" "keyed on the ref"

fixture "$(wf 'concurrency:
  group: ci-${{ github.ref_name }}' "$TIMEOUT" "acme/tool@$COMMIT")"
refused "a push group keyed on ref_name" "keyed on the ref"

fixture "$(wf 'concurrency:
  group: tofu-${{ github.event_name == '"'pull_request'"' && github.ref || github.run_id }}' "$TIMEOUT" "acme/tool@$COMMIT")"
accepted "a ref key with a run_id fallback"

fixture "$(wf "" "$TIMEOUT
    concurrency:
      group: build-\${{ github.ref }}" "acme/tool@$COMMIT")"
refused "a job-level group keyed on the ref alone" "keyed on the ref"

fixture "name: x
on:
  pull_request:
concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true
jobs:
  j:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - run: 'true'"
accepted "a ref-keyed group in a workflow with no push trigger"

fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "acme/tool@$TAG")"
refused "a pin to an annotated tag object" "annotated tag object"

fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "acme/tool@v1")"
accepted "a tag name, which the pin rules of the repository judge"

fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "./.github/actions/x")"
accepted "a local action"

fixture "name: x
on: push
jobs:
  call:
    uses: acme/tool/.github/workflows/w.yml@$TAG"
refused "a reusable workflow pinned to a tag object" "annotated tag object"

# In a repository with the mise task ci, a pull request workflow runs its checks only as `mise run ci -- <part>`.
ci_wf() { # <run lines of the step>
  printf 'name: x\non:\n  pull_request:\njobs:\n  j:\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - run: |\n%s\n' "$1"
}
has_ci() { mkdir -p "$tmp/r/mise-tasks/ci"; : > "$tmp/r/mise-tasks/ci/_default"; }
fixture "$(ci_wf '          ci-mise-setup
          mise run ci -- affected --github-output')"; has_ci
accepted "plumbing and mise run ci -- <part>"

for bad in 'mise run test:lint' 'mise run check' 'mise run ci:lint' 'bash tests/x.sh' 'tests/x.sh' 'shared/scripts/workflow-pins-check.py' 'hooks/check-conflict-markers' 'mise run ci -- lint && mise run test:x' 'mise run ci -- Lint'; do
  fixture "$(ci_wf "          $bad")"; has_ci
  refused "a check run as '$bad'" "outside \`mise run ci -- <part>\`"
done

fixture "$(ci_wf "          if gh api x | grep -qE '^(platform/|tests/diff/)'; then echo mise run test:x; fi")"; has_ci
accepted "a path or a command name inside a quoted pattern or an echo"

fixture "$(ci_wf '          bash tests/x.sh')"
accepted "a check call in a repository with no ci task"

fixture "name: x
on:
  schedule:
    - cron: '0 1 * * *'
jobs:
  j:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - run: mise run test:x"; has_ci
accepted "a workflow with no pull_request trigger"
big=$(head -c 75000 /dev/zero | base64 -w0)
fixture "$(wf "$GOOD_GROUP" "$TIMEOUT
    env:
      BUNDLE: $big" "acme/tool@$COMMIT")"
refused "an env value over 100000 bytes (the exec limit of one variable is 131072)" "env BUNDLE is"
fixture "$(wf "$GOOD_GROUP" "$TIMEOUT
    env:
      SMALL: ${big:0:90000}" "acme/tool@$COMMIT")"
accepted "an env value under the limit"
long=$(head -c 46000 /dev/zero | base64 -w76 | sed 's/^/          /')
fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "acme/tool@$COMMIT")
      - run: |
          base64 -d <<'B' >/dev/null
$long
          B"
refused "a run script over 60000 bytes (actionlint's shellcheck pass hangs on a script past the 64 KiB pipe buffer)" "run script is"
fixture "$(wf "$GOOD_GROUP" "$TIMEOUT" "acme/tool@$COMMIT")
      - run: |
          base64 -d <<'B' >/dev/null
${long:0:50000}
          B"
accepted "a run script under the limit"
echo "a job without timeout, a ref-keyed push group, a tag-object pin, a check run outside mise run ci, an env value too large to exec and a run script too large to lint are refused"
