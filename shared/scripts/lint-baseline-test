#!/usr/bin/env bash
#MISE description="lint-baseline on a throwaway repository: shellcheck and shfmt, ruff check and format, yamllint --strict and gitleaks each refuse their bad case, only tracked files count, vendored copies and tests/*/bad|good fixtures are skipped, and one part never fails for another"
# lint-baseline-test [path of lint-baseline]: the default is the copy next to this script (a vendored copy sits wherever .github/shared-scripts puts it).
# Needs shellcheck, shfmt, ruff, yamllint and gitleaks on PATH.
# shellcheck disable=SC1091,SC2154,SC2016 # the library is a sibling file; $tmp comes from it; the fixtures are single-quoted on purpose
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/testlib.sh"
check=${1:-$here/lint-baseline}
[ -x "$check" ] || fail "no executable lint-baseline at $check"
check=$(cd "$(dirname "$check")" && pwd)/$(basename "$check")
for t in shellcheck shfmt ruff yamllint gitleaks; do command -v "$t" >/dev/null || fail "$t is not on PATH"; done
tmpdir
G=git
secret="token = \"$(printf '%s%s' ghp_ R7hK2mQ9xT4vB8nL1cZ5wY3pD6sF0jG2aE9u)\""

# fresh: a clean tracked tree in $tmp/r with one vendored copy and a yamllint config
put() { mkdir -p "$(dirname "$tmp/r/$1")"; cat > "$tmp/r/$1"; }
fresh() {
  rm -rf "$tmp/r"; git_repo "$tmp/r"
  printf '# canonical-name  local-path\nwt-gc mise-tasks/wt/gc\nmod lib/mod.py\n' | put .github/shared-scripts
  printf 'extends: default\nrules:\n  line-length: disable\n  document-start: disable\n  truthy: disable\n' | put .yamllint
  printf '#!/usr/bin/env bash\nset -euo pipefail\necho "$1"\nif true; then\n  echo ok\nfi\n' | put tools/good.sh
  printf 'import sys\n\n\ndef main():\n    return len(sys.argv)\n' | put lib/good.py
  printf 'a: 1\nb:\n  - x\n' | put conf/good.yaml
  printf '#!/usr/bin/env bash\nset -euo pipefail\necho "$1"\n' | put mise-tasks/wt/gc
  printf 'import os\n' | put lib/mod.py
  "$G" -C "$tmp/r" add -A
}
# add <path>: the file from stdin, tracked
add() { put "$1"; "$G" -C "$tmp/r" add "$1"; }
run() { (cd "$tmp/r" && "$check" "$@") >"$tmp/out" 2>&1; }
ok() { run "$@" || { cat "$tmp/out" >&2; fail "refused a clean tree: $*"; }; }
bad() { # <label> <part> [text the output names]
  if run "$2"; then fail "accepted: $1"; fi
  [ -z "${3:-}" ] || grep -qF -- "$3" "$tmp/out" || { cat "$tmp/out" >&2; fail "the refusal of '$1' does not name $3"; }
}

fresh
for part in shell python yaml secrets all --fast; do ok "$part"; done

fresh; printf '#!/usr/bin/env bash\necho $1\n' | add tools/bad.sh
bad "shellcheck" shell tools/bad.sh
fresh; printf '#!/usr/bin/env bash\nif true; then\necho ok\nfi\n' | add tools/bad.sh
bad "shfmt" shell tools/bad.sh
fresh; printf '#!/usr/bin/env bash\necho $1\n' | add mise-tasks/lint-me
bad "a shell script found by its shebang" shell mise-tasks/lint-me
fresh; printf '#!/usr/bin/env python3\nimport os\n' | add mise-tasks/py-me
bad "a python script found by its shebang" python mise-tasks/py-me
fresh; printf 'import os\n' | add lib/bad.py
bad "ruff check" python lib/bad.py
fresh; printf 'x=1\n' | add lib/bad.py
bad "ruff format" python lib/bad.py
fresh; printf 'a: 1 \n' | add conf/bad.yaml
bad "yamllint" yaml conf/bad.yaml
fresh; printf 'a: 1\n' | add conf/bad.yml; printf 'x: [\n' | add conf/broken.yml
bad "a broken .yml" yaml conf/broken.yml
fresh; printf '%s\n' "$secret" | add conf/leak.txt
bad "gitleaks" secrets conf/leak.txt

fresh; printf 'import os\n' | add lib/bad.py
for part in shell yaml secrets; do ok "$part"; done
fresh; printf '#!/usr/bin/env bash\necho $1\n' | add tools/bad.sh
for part in python yaml secrets; do ok "$part"; done
if run all; then fail "all accepted a bad shell script"; fi
if run --fast; then fail "--fast accepted a bad shell script"; fi

fresh; printf '#!/usr/bin/env bash\necho $1\n' | put tools/untracked.sh; printf 'a: 1 \n' | put conf/untracked.yaml; printf '%s\n' "$secret" | put conf/untracked.txt
for part in shell yaml secrets all; do ok "$part"; done

fresh
printf '#!/usr/bin/env bash\necho $1\n' | add mise-tasks/wt/gc
ok shell
printf 'x=1\n' | add lib/mod.py
ok python
for kind in bad good; do
  printf '#!/usr/bin/env bash\necho $1\n' | add "tests/x/$kind/f.sh"
  printf 'import os\n' | add "tests/x/$kind/f.py"
  printf 'a: 1 \n' | add "tests/x/$kind/f.yaml"
done
for part in shell python yaml; do ok "$part"; done

fresh; rm "$tmp/r/lib/good.py" "$tmp/r/conf/good.yaml"
ok all

fresh; "$G" -C "$tmp/r" rm -q -rf lib conf tools mise-tasks
ok all

fresh
list=$(cd "$tmp/r" && "$check" --list shell | sort | tr '\n' ' ')
[ "$list" = "tools/good.sh " ] || fail "--list shell is '$list', not the own shell scripts without the vendored copy"
list=$(cd "$tmp/r" && "$check" --list python | sort | tr '\n' ' ')
[ "$list" = "lib/good.py " ] || fail "--list python is '$list', not the own python files without the vendored copy"

rc=0; run nonsense || rc=$?
[ "$rc" = 2 ] || fail "an unknown part must exit 2, got $rc"

fresh; "$G" -C "$tmp/r" rm -q -f .github/shared-scripts
bad "a repository with no manifest vendors nothing" python lib/mod.py
echo "lint-baseline ok"
