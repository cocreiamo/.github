#!/usr/bin/env bash
# container-leaks-check on fixture trees: a docker run or create with neither --rm nor the cocreiamo.test labels is refused (a killed run leaks the container), as are
# labelled containers in a script that never turns SIGTERM into an exit, a `leak-ok:` without a reason, an allowlist line without a reason, and a STALE allowlist line
# (a path that no longer exists, a file with no offending call left); --rm, the labels with a TERM trap, a vouched statement, a comment, a non-script file and an
# allowlisted file or directory pass.
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
check="$repo/shared/scripts/container-leaks-check"
[ ! -f "$repo/.github/shared-scripts" ] || check="$repo/$(awk '$1 == "container-leaks-check" { print $2 }' "$repo/.github/shared-scripts")"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }
d=dock""er
fixture() { rm -rf "$tmp/r"; mkdir -p "$tmp/r/tools" "$tmp/r/.github"; }
put() { printf '#!/usr/bin/env bash\n%s\n' "$2" > "$tmp/r/$1"; }
refused() { # <what> <text in the refusal>
  if "$check" "$tmp/r" > "$tmp/out" 2>&1; then cat "$tmp/out" >&2; fail "accepted $1"; fi
  grep -qF "$2" "$tmp/out" || { cat "$tmp/out" >&2; fail "refused $1 without saying '$2'"; }
}
accepted() { "$check" "$tmp/r" > "$tmp/out" 2>&1 || { cat "$tmp/out" >&2; fail "refused $1: $(cat "$tmp/out")"; }; }

fixture
put tools/leaky "$d run -d --name t img sleep 60"
refused "a run with no --rm and no labels" "tools/leaky"
grep -qF "1 call" "$tmp/out" || fail "the offenders are not counted: $(cat "$tmp/out")"
put tools/leaky "$d create --name t img"
refused "a create with no --rm and no labels" "tools/leaky"
put tools/leaky "$d run -d \\
  --name t \\
  img"
refused "a multi-line run with no --rm" "tools/leaky"
printf 'import subprocess\nsubprocess.run(["%s", "run", "-d", "img"])\n' "$d" > "$tmp/r/tools/leaky.py"
rm "$tmp/r/tools/leaky"
refused "a Python run with no --rm" "tools/leaky.py"

fixture
put tools/no-trap "trap 'rm -rf x' EXIT
$d run -d --label cocreiamo.test=1 --label cocreiamo.test.created=1 img"
refused "labelled containers with no TERM trap" "SIGTERM"
put tools/no-trap "$d run -d --label cocreiamo.test=1 --label cocreiamo.test.created=1 img
trap 'rm -rf x' EXIT INT TERM HUP"
accepted "labelled containers with a TERM trap"
put tools/no-trap "trap 'rm -rf x' EXIT INT TERM HUP
$d run -d --label cocreiamo.test=1 img"
refused "a marker label without the creation time" "tools/no-trap"

fixture
put tools/vouch "$d run img # leak-ok:"
refused "a leak-ok with no reason" "without a reason"

fixture
put tools/clean "$d run --rm img true"
put tools/clean2 "$d run -d \\
  --rm img"
put tools/vouched "# leak-ok: a one-shot the caller removes
$d run img true"
put tools/comment "# $d run img in the docs only"
printf '%s run img\n' "$d" > "$tmp/r/notes.md"
accepted "the clean scripts"

fixture
cp "$check" "$tmp/r/tools/container-leaks-check"
accepted "the check itself"

fixture
put tools/leaky "$d run -d img"
printf 'tools/leaky\n' > "$tmp/r/.github/container-leaks-allowlist"
refused "an allowlist line with no reason" "reason"
printf 'tools/leaky the caller removes the container\n' > "$tmp/r/.github/container-leaks-allowlist"
accepted "an allowlisted file"

put tools/leaky "$d run --rm img"
refused "a stale allowlist line (nothing left to excuse)" "tools/leaky"
grep -qF "no longer has a container that leaks" "$tmp/out" || fail "stale line not explained: $(cat "$tmp/out")"
rm "$tmp/r/tools/leaky"
refused "an allowlist line for a path that is gone" "no longer exists"

fixture
mkdir -p "$tmp/r/vendor/up"
put vendor/up/run "$d run -d img"
put tools/leaky "$d run -d img"
printf 'vendor/up/ vendored upstream\n' > "$tmp/r/.github/container-leaks-allowlist"
refused "a leak outside an allowlisted directory" "tools/leaky"
grep -qF "vendor/up" "$tmp/out" && fail "a directory line did not exclude vendor/up: $(cat "$tmp/out")"
rm "$tmp/r/tools/leaky"
accepted "an allowlisted directory"
put vendor/up/run "$d run --rm img"
refused "a stale directory line" "no longer has a container that leaks"

echo "container-leaks-check: ok"
