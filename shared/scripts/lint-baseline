#!/usr/bin/env bash
#MISE description="The shared lint baseline of every own script, config and file: shellcheck and shfmt on shell, ruff check and format on Python, yamllint --strict on YAML, prettier --check on YAML, Markdown, JSON and JS, gitleaks on the tree; tracked files only, vendored copies (.github/shared-scripts), templates (*.j2, *.jinja, *.jinja2, *.tmpl, *.tpl, *.erb, *.mustache) and the deliberate fixtures (tests/*/bad, tests/*/good) skipped. One part only: shell, python, yaml, format, secrets"
# lint-baseline [shell|python|yaml|format|secrets|all|--fast]   runs at the root of the repository (a vendored copy sits wherever .github/shared-scripts puts it).
#   lint-baseline --list shell|python|format   prints the files that part checks.
# The rules are the repository's own configuration (.shellcheckrc, .editorconfig for shfmt, ruff.toml or pyproject.toml, .yamllint, .prettierrc.json and
# .prettierignore, .gitleaks.toml): the script decides what is checked, the configs decide how strictly. One formatter per file type: prettier owns YAML,
# Markdown, JSON and JS, shfmt shell, ruff Python. Needs shellcheck, shfmt, ruff, yamllint, prettier and gitleaks (the shared mise tools block pins them).
set -euo pipefail
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

declare -A vendored=()
if [ -f .github/shared-scripts ]; then
  while read -r _ path _; do [ -z "${path:-}" ] || vendored["$path"]=1; done < <(grep -vE '^[[:space:]]*(#|$)' .github/shared-scripts)
fi

# own_files shell|python|yaml: tracked files of that kind, minus the vendored copies and the fixtures that must stay byte-exact
own_files() {
  local kind=$1 f
  while IFS= read -r -d '' f; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    case "$f" in tests/*/bad/* | tests/*/good/*) continue ;; esac
    [ -z "${vendored[$f]:-}" ] || continue
    case "$f" in *.j2 | *.jinja | *.jinja2 | *.tmpl | *.tpl | *.erb | *.mustache) continue ;; esac
    case "$kind:$f" in
    shell:*.sh | python:*.py | yaml:*.yaml | yaml:*.yml | yaml:.yamllint | yaml:*/.yamllint | format:*.yaml | format:*.yml | format:*.md | format:*.json | format:*.js | format:*.mjs | format:*.cjs)
      printf '%s\n' "$f"
      continue
      ;;
    yaml:* | format:*) continue ;;
    esac
    case "$kind" in
    shell) head -n 1 "$f" 2>/dev/null | grep -aqE '^#!.*(bash|dash|/sh|env +(-S +)?sh)( |$)' && printf '%s\n' "$f" ;;
    python) head -n 1 "$f" 2>/dev/null | grep -aqE '^#!.*(python|uv run)' && printf '%s\n' "$f" ;;
    esac
  done < <(git ls-files -z)
  return 0
}

lint_shell() {
  local files
  mapfile -t files < <(own_files shell)
  [ "${#files[@]}" -gt 0 ] || return 0
  shellcheck "${files[@]}"
  shfmt -d "${files[@]}"
}

lint_python() {
  local files
  mapfile -t files < <(own_files python)
  [ "${#files[@]}" -gt 0 ] || return 0
  ruff check --force-exclude "${files[@]}"
  ruff format --check --force-exclude "${files[@]}"
}

lint_yaml() {
  local files
  mapfile -t files < <(own_files yaml)
  [ "${#files[@]}" -gt 0 ] || return 0
  yamllint --strict "${files[@]}"
}

lint_format() {
  local files config=()
  mapfile -t files < <(own_files format)
  [ "${#files[@]}" -gt 0 ] || return 0
  # cocreiamo/.github keeps the canonical config in shared/config, not at its root
  [ -e .prettierrc.json ] || [ ! -f shared/config/.prettierrc.json ] || config=(--config shared/config/.prettierrc.json)
  prettier --check --log-level warn "${config[@]}" "${files[@]}"
}

lint_secrets() {
  local tree f
  tree=$(mktemp -d)
  # shellcheck disable=SC2064 # the path is fixed now, on purpose
  trap "rm -rf '$tree'" EXIT
  while IFS= read -r -d '' f; do
    { [ -f "$f" ] || [ -L "$f" ]; } && printf '%s\0' "$f"
  done < <(git ls-files -z) | tar --null -T - -cf - | tar -xf - -C "$tree"
  (cd "$tree" && gitleaks dir . --no-banner --redact --verbose --exit-code 1)
}

if [ "${1:-}" = "--list" ]; then
  own_files "${2:?shell, python or format}"
  exit 0
fi
case "${1:-all}" in
shell) lint_shell ;;
python) lint_python ;;
yaml) lint_yaml ;;
format) lint_format ;;
secrets) lint_secrets ;;
all | --fast)
  lint_shell
  lint_python
  lint_yaml
  lint_format
  lint_secrets
  ;;
*)
  echo "unknown part: $1" >&2
  exit 2
  ;;
esac
