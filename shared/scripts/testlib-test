#!/usr/bin/env bash
#MISE description="shared/scripts/testlib.sh: fail exits 1 with FAIL on stderr; tmpdir makes a directory removed at exit; stub_bin puts an executable stub first on PATH; fake_gh answers gh api per canned route and refuses what it does not know; git_env_clear unsets git's local environment; git_repo makes a throwaway repository that no hook or config of the real one reaches"
# shellcheck disable=SC1090,SC1091,SC2154,SC2030,SC2031 # the library is sourced by a computed path; $tmp comes from it; the GIT_* exports are meant to stay in their subshells
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
lib=$here/testlib.sh
[ -f "$lib" ] || { echo "FAIL: $lib is missing" >&2; exit 1; }
# shellcheck source=testlib.sh
. "$lib"

rc=0; out=$( ( . "$lib"; fail "boom here" ) 2>&1 ) || rc=$?
[ "$rc" = 1 ] || fail "fail must exit 1, got $rc"
[ "$out" = "FAIL: boom here" ] || fail "fail must print 'FAIL: <message>' on stderr, got '$out'"

dirfile=$(mktemp); trap 'rm -f "$dirfile"' EXIT
( . "$lib"; tmpdir; echo x > "$tmp/f"; echo "$tmp" > "$dirfile" )
d=$(cat "$dirfile")
[ -n "$d" ] || fail "tmpdir did not set \$tmp"
[ ! -e "$d" ] || fail "tmpdir left $d behind after the shell exited"
( . "$lib"; tmpdir; echo "$tmp" > "$dirfile"; exit 3 ) || true
[ ! -e "$(cat "$dirfile")" ] || fail "tmpdir left its directory behind after a failing shell"

tmpdir
stub_bin hello 'echo "hello $*"'
[ "$(hello a b)" = "hello a b" ] || fail "the stub is not found on PATH or ignores its arguments"
[ "$(command -v hello)" = "$tmp/bin/hello" ] || fail "the stub is not under \$tmp/bin"
stub_bin viastdin <<'STUB'
echo "stdin $1"
STUB
[ "$(viastdin q)" = "stdin q" ] || fail "a stub body read from stdin does not run"
stub_bin hello 'echo second'
[ "$(hello)" = second ] || fail "a second stub_bin of the same name does not replace the first"
[ "$(printf '%s' "$PATH" | tr ':' '\n' | grep -cx "$tmp/bin")" = 1 ] || fail "\$tmp/bin is on PATH more than once"

fake_gh
fake_gh_route repos/o/r/pulls/7 '{"number":7,"title":"x"}'
fake_gh_route 'repos/o/r/issues?state=open' '[{"number":1}]'
[ "$(gh api repos/o/r/pulls/7)" = '{"number":7,"title":"x"}' ] || fail "gh api does not return the canned JSON"
[ "$(gh api /repos/o/r/pulls/7)" = '{"number":7,"title":"x"}' ] || fail "a leading slash must not matter"
[ "$(gh api repos/o/r/pulls/7 --jq .number)" = 7 ] || fail "--jq is not applied"
[ "$(gh api -X GET repos/o/r/pulls/7 -q .title)" = x ] || fail "a method flag and -q are not handled"
[ "$(gh api 'repos/o/r/issues?state=open')" = '[{"number":1}]' ] || fail "a route with a query string is not matched exactly"
[ "$(gh api 'repos/o/r/pulls/7?per_page=1')" = '{"number":7,"title":"x"}' ] || fail "a query string with no route of its own must fall back to the path"
rc=0; gh api repos/o/r/pulls/8 >"$tmp/o" 2>"$tmp/e" || rc=$?
[ "$rc" != 0 ] || fail "an unknown route must fail"
grep -q 'Not Found' "$tmp/e" || fail "an unknown route must say Not Found on stderr"
rc=0; gh pr list >"$tmp/o" 2>"$tmp/e" || rc=$?
[ "$rc" != 0 ] || fail "a gh command other than api must be refused"
grep -qF 'repos/o/r/pulls/7' "$FAKE_GH_LOG" || fail "the calls are not logged in \$FAKE_GH_LOG"
fake_gh_route repos/o/r/pulls/7 '{"number":70}'
[ "$(gh api repos/o/r/pulls/7 --jq .number)" = 70 ] || fail "registering a route again must replace it"

# git_env_clear: inside a git hook GIT_DIR and friends point at the real repository
real=$(mktemp -d); trap 'rm -rf "$real"' EXIT
vcs() { git "$@"; }
vcs init -q "$real/r"
( . "$lib"
  export GIT_DIR="$real/r/.git" GIT_WORK_TREE="$real/r" GIT_INDEX_FILE="$real/r/.git/index" GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.abbrev GIT_CONFIG_VALUE_0=12
  git_env_clear
  [ -z "$(env | grep -E '^GIT_(DIR|WORK_TREE|INDEX_FILE|CONFIG_COUNT)=' || true)" ] ) || fail "git_env_clear left a local git variable set"
( . "$lib"; export GIT_AUTHOR_NAME=keep; git_env_clear; [ "${GIT_AUTHOR_NAME:-}" = keep ] ) || fail "git_env_clear must not unset what is not a local variable"

# git_repo <dir>: a repository on main with a test identity and no signing, set in its own config only
before=$(git -C "$real/r" config --local --list | sort)
( . "$lib"
  tmpdir
  export GIT_DIR="$real/r/.git" GIT_WORK_TREE="$real/r"
  git_repo "$tmp/t"
  unset GIT_DIR GIT_WORK_TREE
  [ "$(git -C "$tmp/t" symbolic-ref --short HEAD)" = main ] || { echo "the branch is not main" >&2; exit 1; }
  [ "$(git -C "$tmp/t" config user.email)" = t@example.invalid ] || { echo "no test identity" >&2; exit 1; }
  [ "$(git -C "$tmp/t" config commit.gpgsign)" = false ] || { echo "signing is not off" >&2; exit 1; }
  [ "$(git -C "$tmp/t" rev-parse --show-toplevel)" = "$(cd "$tmp/t" && pwd -P)" ] || { echo "the repository is not its own" >&2; exit 1; }
  echo x > "$tmp/t/f"; git -C "$tmp/t" add f; vcs -C "$tmp/t" commit -qm "test: x"
) || fail "git_repo did not make a usable throwaway repository"
[ "$before" = "$(git -C "$real/r" config --local --list | sort)" ] || fail "git_repo changed the config of the repository the hook runs in"
echo "testlib ok"
