#!/usr/bin/env bash
# The checks the CI runs on what this push changes run before the push: a red CI for something a local check finds is a wasted round.
# Deleting a branch and pushing a tag need no check. The gate that cannot be skipped is the ruleset on GitHub.
set -euo pipefail
deleting_only=true
while read -r local_ref local_sha _; do
  case "$local_ref" in
    refs/tags/*) ;;
    *) [ "$local_sha" = 0000000000000000000000000000000000000000 ] || deleting_only=false ;;
  esac
done
[ "$deleting_only" = false ] || exit 0
# git exports GIT_DIR and the like to a hook: the tests that make throwaway repositories would act on this one.
# shellcheck disable=SC2046 # the names contain no spaces
unset $(git rev-parse --local-env-vars)
echo "pre-push: mise run ci -- prepush (the parts of the CI that this push touches)" >&2
mise run ci -- prepush || { echo "refused: the CI checks fail, fix them before the push" >&2; exit 1; }
